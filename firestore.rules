rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Products (Cakes) collection
    match /products/{productId} {
      // Anyone can view products
      allow read: if true;
      // Only admins can create/update/delete products
      allow write: if isAdmin();
    }

    // Courses collection
    match /courses/{courseId} {
      // Anyone can view course metadata
      allow read: if true;
      // Only admins can manage courses
      allow write: if isAdmin();
    }

    // Users (Profiles) collection
    match /users/{userId} {
      // Users can only read/write their own profiles, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // Orders collection
    match /orders/{orderId} {
      // Users can read/write their own orders
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      // Admins can manage all orders
      allow read, write: if isAdmin();
      // Allow creation if the user is setting their own ID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
