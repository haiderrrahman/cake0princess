rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if the user is an admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /courses/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
