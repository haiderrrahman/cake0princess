  user_input {
    user_response: "\"use client\";\nimport { useState } from \"react\";\n\nexport default function CakePublisher() {\n  const [caption, setCaption] = useState(\"\");\n  const [imageFile, setImageFile] = useState(null);\n  const [preview, setPreview] = useState(null);\n\n  // \330\257\330\247\331\204\330\251 \330\247\330\256\330\252\331\212\330\247\330\261 \330\247\331\204\330\265\331\210\330\261\330\251\n  const handleImageChange = (e) => {\n    const file = e.target.files[0];\n    if (file) {\n      setImageFile(file);\n      setPreview(URL.createObjectURL(file));\n    }\n  };\n\n  // \330\257\330\247\331\204\330\251 \330\247\331\204\331\206\330\264\330\261 (\331\206\330\263\330\256 \330\247\331\204\331\206\330\265 + \331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\330\265\331\210\330\261\330\251)\n  const handleShare = async () => {\n    if (!imageFile) {\n      alert(\"\342\232\240\357\270\217 \331\212\330\261\330\254\331\211 \330\247\330\256\330\252\331\212\330\247\330\261 \330\265\331\210\330\261\330\251 \330\247\331\204\331\203\331\212\331\203\330\251 \330\243\331\210\331\204\330\247\331\213!\");\n      return;\n    }\n\n    // 1. \331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \330\245\331\204\331\211 \330\247\331\204\330\255\330\247\331\201\330\270\330\251 (Clipboard)\n    if (caption) {\n      try {\n        await navigator.clipboard.writeText(caption);\n        console.log(\"\330\252\331\205 \331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \330\250\331\206\330\254\330\247\330\255\");\n      } catch (err) {\n        console.error(\"\331\201\330\264\331\204 \331\201\331\212 \331\206\330\263\330\256 \330\247\331\204\331\206\330\265:\", err);\n      }\n    }\n\n    // 2. \330\247\331\204\330\252\330\255\331\202\331\202 \331\205\331\206 \330\257\330\271\331\205 \330\247\331\204\331\205\330\252\330\265\331\201\330\255 \331\204\331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\331\205\331\204\331\201\330\247\330\252\n    if (navigator.canShare && navigator.canShare({ files: [imageFile] })) {\n      try {\n        // \331\201\330\252\330\255 \331\202\330\247\330\246\331\205\330\251 \330\247\331\204\331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\330\243\330\265\331\204\331\212\330\251 \331\201\331\212 \330\247\331\204\330\243\331\212\331\201\331\210\331\206\n        await navigator.share({\n          files: [imageFile],\n          title: \"\331\205\331\206\330\264\331\210\330\261 \330\247\331\204\331\203\331\212\331\203\",\n        });\n        // \330\250\330\271\330\257 \331\205\330\247 \331\212\330\256\330\252\330\247\330\261 \330\247\331\204\331\205\330\263\330\252\330\256\330\257\331\205 \330\247\331\204\330\247\331\206\330\263\330\252\330\247 \330\247\331\210 \330\247\331\204\330\252\331\212\331\203 \330\252\331\210\331\203\330\214 \330\250\330\263 \331\212\330\263\331\210\331\212 \331\204\330\265\331\202 \331\204\331\204\331\206\330\265!\n      } catch (error) {\n        console.error(\"\330\252\331\205 \330\247\331\204\330\245\331\204\330\272\330\247\330\241 \330\243\331\210 \331\201\330\264\331\204 \330\247\331\204\331\205\330\264\330\247\330\261\331\203\330\251:\", error);\n      }\n    } else {\n      alert(\"\331\205\330\252\330\265\331\201\330\255\331\203 \331\204\330\247 \331\212\330\257\330\271\331\205 \331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\330\265\331\210\330\261 \331\205\330\250\330\247\330\264\330\261\330\251 (\330\247\330\263\330\252\330\256\330\257\331\205 Safari \330\250\330\247\331\204\330\247\331\212\331\201\331\210\331\206).\");\n    }\n  };\n\n  return (\n    <div style={{ padding: \"20px\", maxWidth: \"400px\", margin: \"0 auto\", fontFamily: \"sans-serif\" }}>\n      <h2 style={{ textAlign: \"center\", color: \"#d23f57\" }}>\360\237\215\260 \331\206\330\270\330\247\331\205 \331\206\330\264\330\261 \330\247\331\204\331\203\331\212\331\203 \330\247\331\204\331\205\331\210\330\255\330\257</h2>\n      \n      <div style={{ marginBottom: \"15px\" }}>\n        <label style={{ display: \"block\", marginBottom: \"5px\", fontWeight: \"bold\" }}>\n          \331\210\330\265\331\201 \330\247\331\204\331\205\331\206\330\264\331\210\330\261 \331\210\330\247\331\204\331\207\330\247\330\264\330\252\330\247\331\203\330\247\330\252:\n        </label>\n        <textarea\n          rows=\"5\"\n          style={{ width: \"100%\", padding: \"10px\", borderRadius: \"8px\", border: \"1px solid #ccc\" }}\n          placeholder=\"\331\205\330\253\330\247\331\204: \331\203\331\212\331\203\330\251 \330\264\331\210\331\203\331\210\331\204\330\247\330\252\330\251 \330\254\330\247\331\207\330\262\330\251 \331\204\331\204\330\252\331\210\330\265\331\212\331\204... #\331\203\331\212\331\203 #\330\250\330\272\330\257\330\247\330\257\"\n          value={caption}\n          onChange={(e) => setCaption(e.target.value)}\n        />\n      </div>\n\n      <div style={{ marginBottom: \"15px\" }}>\n        <label style={{ display: \"block\", marginBottom: \"5px\", fontWeight: \"bold\" }}>\n          \330\265\331\210\330\261\330\251 \330\247\331\204\331\203\331\212\331\203\330\251:\n        </label>\n        <input \n          type=\"file\" \n          accept=\"image/*\" \n          onChange={handleImageChange} \n          style={{ display: \"block\", marginBottom: \"10px\" }}\n        />\n        {preview && (\n          <img \n            src={preview} \n            alt=\"\331\205\330\271\330\247\331\212\331\206\330\251\" \n            style={{ width: \"100%\", borderRadius: \"8px\", border: \"1px solid #eee\" }} \n          />\n        )}\n      </div>\n\n      <button\n        onClick={handleShare}\n        style={{\n          width: \"100%\",\n          padding: \"15px\",\n          backgroundColor: \"#d23f57\",\n          color: \"white\",\n          border: \"none\",\n          borderRadius: \"8px\",\n          fontSize: \"16px\",\n          fontWeight: \"bold\",\n          cursor: \"pointer\"\n        }}\n      >\n        \360\237\232\200 \330\247\331\206\330\264\330\261 \330\247\331\204\330\242\331\206 (\331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \331\210\331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\330\265\331\210\330\261\330\251)\n      </button>\n\n      <p style={{ fontSize: \"12px\", color: \"#666\", textAlign: \"center\", marginTop: \"15px\" }}>\n        * \331\205\331\206 \330\252\330\266\330\272\330\267 \330\271\331\204\331\211 \330\247\331\204\330\262\330\261\330\214 \330\261\330\247\330\255 \331\212\331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \330\252\331\204\331\202\330\247\330\246\331\212\330\247\331\213 \331\210\331\212\331\201\330\252\330\255\331\204\331\203 \331\202\330\247\330\246\331\205\330\251 \330\247\331\204\330\247\331\212\331\201\331\210\331\206 \330\255\330\252\331\211 \330\252\330\256\330\252\330\247\330\261 (\330\247\331\206\330\263\330\252\330\247/\331\201\331\212\330\263/\330\252\331\212\331\203 \330\252\331\210\331\203)\330\214 \331\210\330\250\330\271\330\257\331\207\330\247 \330\250\330\263 \330\247\331\206\330\267\331\212 \"\331\204\330\265\331\202\".\n      </p>\n    </div>\n  );\n}"
