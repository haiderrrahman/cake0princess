      replacement_content: "import React, { useState } from \"react\";\nimport { Share2, Image as ImageIcon, Copy, AlertCircle, CheckCircle2 } from \"lucide-react\";\n\nexport default function CakePublisher() {\n  const [caption, setCaption] = useState(\"\");\n  const [imageFile, setImageFile] = useState<File | null>(null);\n  const [preview, setPreview] = useState<string | null>(null);\n  const [status, setStatus] = useState<{ type: \'success\' | \'error\' | null, message: string }>({ type: null, message: \"\" });\n\n  const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      setImageFile(file);\n      setPreview(URL.createObjectURL(file));\n      setStatus({ type: null, message: \"\" });\n    }\n  };\n\n  const handleShare = async () => {\n    if (!imageFile) {\n      setStatus({ type: \'error\', message: \"\342\232\240\357\270\217 \331\212\330\261\330\254\331\211 \330\247\330\256\330\252\331\212\330\247\330\261 \330\265\331\210\330\261\330\251 \330\247\331\204\331\203\331\212\331\203\330\251 \330\243\331\210\331\204\330\247\331\213!\" });\n      return;\n    }\n\n    setStatus({ type: null, message: \"\" });\n    \n    let textCopied = false;\n\n    // 1. Copy text to clipboard\n    if (caption) {\n      try {\n        await navigator.clipboard.writeText(caption);\n        console.log(\"\330\252\331\205 \331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \330\250\331\206\330\254\330\247\330\255\");\n        textCopied = true;\n      } catch (err) {\n        console.error(\"\331\201\330\264\331\204 \331\201\331\212 \331\206\330\263\330\256 \330\247\331\204\331\206\330\265:\", err);\n        setStatus({ type: \'error\', message: \"\331\201\330\264\331\204 \331\201\331\212 \331\206\330\263\330\256 \330\247\331\204\331\206\330\265\330\214 \331\212\330\261\330\254\331\211 \330\247\331\204\331\206\330\263\330\256 \331\212\330\257\331\210\331\212\330\247\331\213.\" });\n        return; // Early return on copy fail if we want to be strict, but maybe proceed to share anyway? \n        // Let\'s proceed even if copy fails, maybe they just want to share the image.\n      }\n    }\n\n    // 2. Share using Web Share API\n    const shareData = {\n      title: \"\331\205\331\206\330\264\331\210\330\261 \330\247\331\204\331\203\331\212\331\203\",\n      files: [imageFile],\n    };\n\n    if (navigator.canShare && navigator.canShare(shareData)) {\n      try {\n        await navigator.share(shareData);\n        setStatus({ \n          type: \'success\', \n          message: textCopied \n            ? \"\330\252\331\205 \331\206\330\263\330\256 \330\247\331\204\331\206\330\265 \331\210\331\201\330\252\330\255 \331\202\330\247\330\246\331\205\330\251 \330\247\331\204\331\205\330\264\330\247\330\261\331\203\330\251 \330\250\331\206\330\254\330\247\330\255! \330\247\331\204\330\265\331\202 \330\247\331\204\331\206\330\265 \331\201\331\212 \330\247\331\204\330\252\330\267\330\250\331\212\331\202.\" \n            : \"\330\252\331\205 \331\201\330\252\330\255 \331\202\330\247\330\246\331\205\330\251 \330\247\331\204\331\205\330\264\330\247\330\261\331\203\330\251 \330\250\331\206\330\254\330\247\330\255!\" \n        });\n      } catch (error) {\n        console.error(\"\330\252\331\205 \330\247\331\204\330\245\331\204\330\272\330\247\330\241 \330\243\331\210 \331\201\330\264\331\204 \330\247\331\204\331\205\330\264\330\247\330\261\331\203\330\251:\", error);\n        // User cancelled or generic error\n      }\n    } else {\n      setStatus({ type: \'error\', message: \"\331\205\330\252\330\265\331\201\330\255\331\203 \331\204\330\247 \331\212\330\257\330\271\331\205 \331\205\330\264\330\247\330\261\331\203\330\251 \330\247\331\204\330\265\331\210\330\261 \331\205\330\250\330\247\330\264\330\261\330\251. \331\212\330\261\330\254\331\211 \330\247\330\263\330\252\330\256\330\257\330\247\331\205 \331\205\330\252\330\265\331\201\330\255 \331\205\330\257\330\271\331\210\331\205 (\331\205\330\253\331\204 Safari \330\250\330\247\331\204\330\247\331\212\331\201\331\210\331\206).\" });\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-gray-50 flex items-center justify-center p-4 font-sans text-right\" dir=\"rtl\">\n      <div className=\"w-full max-w-md bg-white rounded-2xl shadow-xl overflow-hidden\">\n        \n        {/* Header */}\n        <div className=\"bg-rose-500 p-6 text-white text-center\">\n          <h2 className=\"text-2xl font-bold flex items-center justify-center gap-2\">\n            <span>\360\237\215\260</span> \331\206\330\270\330\247\331\205 \331\206\330\264\330\261 \330\247\331\204\331\203\331\212\331\203 \330\247\331\204\331\205\331\210\330\255\330\257\n          </h2>\n          <p className=\"text-rose-100 text-sm mt-2\">\n            \330\264\330\247\330\261\331\203 \330\245\330\250\330\257\330\247\330\271\330\247\330\252\331\203 \330\250\330\263\331\207\331\210\331\204\330\251 \330\271\331\204\331\211 \331\203\331\204 \330\247\331\204\331\205\331\206\330\265\330\247\330\252\n          </p>\n        </div>\n\n        <div className=\"p-6 space-y-6\">\n          \n          {/* Status Message */}\n          {status.message && (\n            <div className={`p-4 rounded-lg flex items-start gap-3 ${status.type === \'error\' ? \'bg-red-50 text-red-700 border border-red-200\' : \'bg-green-50 text-green-700 border border-green-200\'}`}>\n              {status.type === \'error\' ? <AlertCircle className=\"w-5 h-5 flex-shrink-0 mt-0.5\" /> : <CheckCircle2 className=\"w-5 h-5 flex-shrink-0 mt-0.5\" />}\n              <p className=\"text-sm font-medium\">{status.message}</p>\n            </div>\n          )}\n\n          {/* Caption Input */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-sm font-semibold text-gray-700\">\n              \331\210\330\265\331\201 \330\247\331\204\331\205\331\206\330\264\331\210\330\261 \331\210\330\247\331\204\331\207\330\247\330\264\330\252\330\247\331\203\330\247\330\252:\n            </label>\n            <textarea\n              rows={4}\n              className=\"w-full p-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-rose-500 focus:border-rose-500 transition-shadow resize-none\"\n              placeholder=\"\331\205\330\253\330\247\331\204: \331\203\331\212\331\203\330\251 \330\264\331\210\331\203\331\210\331\204\330\247\330\252\330\251 \330\254\330\247\331\207\330\262\330\251 \331\204\331\204\330\252\331\210\330\265\331\212\331\204... #\331\203\331\212\331\203 #\330\250\330\272\330\257\330\247\330\257\"\n              value={caption}\n              onChange={(e) => setCaption(e.target.value)}\n            />\n          </div>\n\n          {/* Image Input */}\n          <div className=\"space-y-2\">\n            <label className=\"block text-sm font-semibold text-gray-700\">\n              \330\265\331\210\330\261\330\251 \330\247\331\204\331\203\331\212\331\203\330\251:\n            </label>\n            \n            <div className=\"relative group\">\n              {preview ? (\n                 <div className=\"relative rounded-lg overflow-hidden border-2 border-gray-200 group-hover:border-rose-400 transition-colors\">\n                    <img \n                      src={preview} \n                      alt=\"\331\205\330\271\330\247\331\212\331\206\330\251\" \n                      className=\"w-full h-48 object-cover aspect-video\" \n                    />\n                    <div className=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center\">\n                       <span className=\"text-white font-medium flex items-center gap-2\">\n                         <ImageIcon className=\"w-5 h-5\" /> \330\252\330\272\331\212\331\212\330\261 \330\247\331\204\330\265\331\210\330\261\330\251\n                       </span>\n                    </div>\n                    <input \n                      type=\"file\" \n                      accept=\"image/*\" \n                      onChange={handleImageChange} \n                      className=\"absolute inset-0 w-full h-full opacity-0 cursor-pointer\"\n                    />\n                 </div>\n              ) : (\n                <label className=\"flex flex-col items-center justify-center w-full h-32 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 hover:border-rose-400 transition-colors\">\n                  <div className=\"flex flex-col items-center justify-center pt-5 pb-6\">\n                    <ImageIcon className=\"w-8 h-8 text-gray-400 mb-2\" />\n                    <p className=\"mb-2 text-sm text-gray-500 font-semibold\">\330\247\330\266\330\272\330\267 \331\204\330\247\330\256\330\252\331\212\330\247\330\261 \330\265\331\210\330\261\330\251</p>\n                    <p className=\"text-xs text-gray-400\">PNG, JPG, GIF</p>\n                  </div>\n                  <input \n                    type=\"file\" \n                    accept=\"image/*\" \n                    className=\"hidden\" \n                    onChange={handleImageChange} \n                  />\n                </label>\n              )}\n            </div>\n          </div>\n\n          {/* Action Button */}\n          <button\n            onClick={handleShare}\n            className=\"w-full py-4 px-6 bg-rose-600 hover:bg-rose-700 active:bg-rose-800 text-white rounded-xl shadow-md font-bold text-lg flex items-center justify-center gap-2 transition-colors focus:ring-4 focus:ring-rose-300\"\n          >\n            <Share2 className=\"w-6 h-6\" />\n            \330\247\331\206\330\264\330\261 \330\247\331\204\330\242\331\206 (\331\206\330\263\330\256 + \331\205\330\264\330\247\330\261\331\203\330\251)\n          </button>\n\n          {/* Hint */}\n          <p className=\"text-xs text-gray-500 text-center leading-relaxed bg-gray-50 p-3 rounded-md\">\n            * \330\271\331\206\330\257 \330\247\331\204\330\266\330\272\330\267 \330\271\331\204\331\211 \330\247\331\204\330\262\330\261\330\214 \330\263\331\212\330\252\331\205 <strong className=\"text-gray-700\">\331\206\330\263\330\256 \330\247\331\204\331\206\330\265</strong> \330\252\331\204\331\202\330\247\330\246\331\212\330\247\331\213 \331\210\331\201\330\252\330\255 \331\202\330\247\330\246\331\205\330\251 \330\247\331\204\331\205\330\264\330\247\330\261\331\203\330\251 \330\250\331\207\330\247\330\252\331\201\331\203. \330\247\330\256\330\252\330\261 \330\247\331\204\330\252\330\267\330\250\331\212\331\202 (\330\247\331\206\330\263\330\252\330\247/\331\201\331\212\330\263/\330\252\331\212\331\203 \330\252\331\210\331\203) \330\253\331\205 \330\247\330\256\330\252\330\261 <strong className=\"text-gray-700\">\"\331\204\330\265\331\202\"</strong>.\n          </p>\n\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
