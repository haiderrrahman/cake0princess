+    const newQty = Math.max(1, (need.quantity || 1) + delta);
+    if (newQty === need.quantity) return;
+    await updateDoc(doc(db, "cake_needs", needId), { quantity: newQty, updatedAt: serverTimestamp() });
+    fetchItems();
+  };
